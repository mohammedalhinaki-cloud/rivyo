# ============================================================
# Rivyo — متغيرات البيئة
# مهم جدًا: هذا مشروع مستقل تمامًا عن منصة MAAOUN.
# - Supabase Project مستقل (لا تستخدم مفاتيح MAAOUN أبدًا)
# - Google Cloud Project مستقل
# - مفاتيح Gemini مستقلة
# انسخ هذا الملف إلى .env.local ثم عبّئ القيم.
# لا ترفع .env.local إلى Git أبدًا.
# ============================================================

# ---------- التطبيق ----------
# الرابط العام للإنتاج (نطاق MAAOUN الفرعي — لا نطاق جديد)
NEXT_PUBLIC_APP_URL=https://reviews.maaoun.com

# في التطوير المحلي اتركه فارغًا ليُشتق تلقائيًا من العنوان الذي تفتحه:
# NEXT_PUBLIC_APP_URL=

# ---------- Google OAuth 2.0 (server-side فقط) ----------
# من Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Supabase (مشروع مستقل جديد خاص بـ Rivyo فقط) ----------
# من Settings -> API في مشروع Rivyo على Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- الأمان ----------
# أنشئهما مرة واحدة عبر: npm run keys
SESSION_SECRET=
ENCRYPTION_KEY=

# ---------- أدمن صفحة الاختبار /admin/google-test ----------
# قائمة بريد إلكتروني مفصولة بفواصل
ADMIN_EMAILS=you@example.com

# ---------- Gemini API (المرحلة الثانية — بعد نجاح اختبار التكامل) ----------
# المفتاح يبقى server-side فقط ولا يُرسل للواجهة أبدًا
GEMINI_API_KEY=
# النموذج قابل للتغيير من هنا دون تعديل الكود.
# gemini-flash-latest = اسم مستعار يتحدث تلقائيًا لأحدث نموذج Flash مستقر
GEMINI_MODEL=gemini-flash-latest
